# ── Load balancer ────────────────────────────────────────────────
LB_PORT=3030
LB_STRATEGY=ai-adaptive          # ai-adaptive | round-robin | least-connections | latency-aware | weighted

# ── Backend pool ─────────────────────────────────────────────────
BACKEND_1_PORT=5001
BACKEND_2_PORT=5002
BACKEND_3_PORT=5003
SPAWN_BACKENDS=true              # auto-start the 3 demo backends
SIMULATE_TRAFFIC=true            # generate synthetic traffic so the 3D scene is alive
SIMULATE_INTERVAL_MS=350

# ── Health monitoring ────────────────────────────────────────────
HEALTH_INTERVAL_MS=4000
HEALTH_TIMEOUT_MS=2500

# ── Agentic core ─────────────────────────────────────────────────
AGENT_INTERVAL_MS=8000

# ── Telemetry ────────────────────────────────────────────────────
TELEMETRY_INTERVAL_MS=500
METRICS_WINDOW_MS=60000

# ── Frontend (Vite) ──────────────────────────────────────────────
# VITE_WS_URL=ws://localhost:3030/metrics
# VITE_API_URL=http://localhost:3030
